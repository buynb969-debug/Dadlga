{
  "name": "dadlaga",
  "main": "dadlaga.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dadlaga",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "."
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dadlaga-files"
    }
  ]
}
